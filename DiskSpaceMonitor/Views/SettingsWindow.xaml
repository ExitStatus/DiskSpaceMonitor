<views:ThemedWindow x:Class="DiskSpaceMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:DiskSpaceMonitor.Views"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Disk Space Monitor — Settings"
        Width="648" Height="600"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True">

    <Window.Resources>
        <!-- Each row's explanation, shared by its caption, its control and its readout so hovering
             anywhere along the row explains the setting. -->
        <sys:String x:Key="IntervalTip">How often the drives are re-read. Longer intervals do less work; the widgets sleep in between either way.</sys:String>
        <sys:String x:Key="WidgetTip">Which style every drive is drawn in. Each style keeps its own colours, size and position, so switching back restores what you had.</sys:String>
        <sys:String x:Key="OpacityTip">How solid the widgets are on the desktop, all styles alike. Lower values let the wallpaper through.</sys:String>
        <sys:String x:Key="FontTip">The typeface every widget draws its text in. Choose… lists the fonts installed on this PC, each shown in its own face.</sys:String>
        <sys:String x:Key="MinFontTip">The smallest any widget will draw text, however small the widget is. Raise it if labels on a squeezed widget are hard to read.</sys:String>
        <sys:String x:Key="MaxFontTip">The largest any widget will draw text, however big the widget is. Lower it to stop a stretched widget turning its labels into a poster.</sys:String>

        <!-- Caption and readout match Views/SettingRow: the caption column sizes to this tab's
             longest caption, and every control starts where it ends. Each tab is its own scope,
             so a long caption on one doesn't indent another. -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="SettingReadout" TargetType="TextBlock">
            <Setter Property="Width" Value="44"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top-level tabs: General, then the selected widget's own tabs (added in code). -->
        <TabControl x:Name="Tabs" Grid.Row="0">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.IsSharedSizeScope="True">
                <StackPanel Margin="10">

                    <!-- The checkbox and the note below carry no caption of their own, so they take
                         an empty one to start where the captioned controls do. -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"/>
                        <CheckBox x:Name="AutoStartCheck" Grid.Column="1" FontSize="13"
                                  VerticalAlignment="Center" Content="Auto-start when I log in"
                                  ToolTip="Start the widgets when you sign in to Windows, by registering this executable in your account's Run key. Publish to a fixed folder first, so the registered path doesn't point at a build folder."/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Update every" Style="{StaticResource SettingLabel}"
                                   ToolTip="{StaticResource IntervalTip}"/>
                        <ComboBox x:Name="IntervalCombo" Grid.Column="1" HorizontalAlignment="Left" MinWidth="130"
                                  ToolTip="{StaticResource IntervalTip}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Widget" Style="{StaticResource SettingLabel}"
                                   ToolTip="{StaticResource WidgetTip}"/>
                        <ComboBox x:Name="WidgetSelector" Grid.Column="1" HorizontalAlignment="Left"
                                  MinWidth="180" SelectionChanged="OnWidgetSelected"
                                  ToolTip="{StaticResource WidgetTip}"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Overall opacity" Style="{StaticResource SettingLabel}"
                                   ToolTip="{StaticResource OpacityTip}"/>
                        <Slider x:Name="OpacitySlider" Grid.Column="1"
                                Minimum="0.2" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                                VerticalAlignment="Center" ValueChanged="OnOpacityChanged"
                                ToolTip="{StaticResource OpacityTip}"/>
                        <TextBlock x:Name="OpacityValue" Grid.Column="2" Style="{StaticResource SettingReadout}"
                                   ToolTip="{StaticResource OpacityTip}"/>
                    </Grid>

                    <Separator Margin="0,14,0,10"/>

                    <TextBlock Text="Text" FontSize="12" Opacity="0.7" Margin="0,0,0,8"/>

                    <!-- The preview is drawn in the chosen font, so the row shows what it will
                         look like rather than just naming it. -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Font" Style="{StaticResource SettingLabel}"
                                   ToolTip="{StaticResource FontTip}"/>
                        <Border Grid.Column="1" Margin="0,0,8,0" Padding="8,5" MinHeight="30"
                                BorderThickness="1" BorderBrush="#40808080" CornerRadius="4"
                                ToolTip="{StaticResource FontTip}">
                            <TextBlock x:Name="FontPreview" FontSize="15" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                        <Button Grid.Column="2" Content="Choose…" Padding="12,5"
                                VerticalAlignment="Center" Click="OnChooseFont"
                                ToolTip="{StaticResource FontTip}"/>
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Minimum size" Style="{StaticResource SettingLabel}"
                                   ToolTip="{StaticResource MinFontTip}"/>
                        <Slider x:Name="MinFontSlider" Grid.Column="1"
                                Minimum="6" Maximum="48" SmallChange="1" LargeChange="4"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="OnMinFontChanged"
                                ToolTip="{StaticResource MinFontTip}"/>
                        <TextBlock x:Name="MinFontValue" Grid.Column="2" Style="{StaticResource SettingReadout}"
                                   ToolTip="{StaticResource MinFontTip}"/>
                    </Grid>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Maximum size" Style="{StaticResource SettingLabel}"
                                   ToolTip="{StaticResource MaxFontTip}"/>
                        <Slider x:Name="MaxFontSlider" Grid.Column="1"
                                Minimum="8" Maximum="200" SmallChange="1" LargeChange="8"
                                TickFrequency="1" IsSnapToTickEnabled="True"
                                VerticalAlignment="Center" ValueChanged="OnMaxFontChanged"
                                ToolTip="{StaticResource MaxFontTip}"/>
                        <TextBlock x:Name="MaxFontValue" Grid.Column="2" Style="{StaticResource SettingReadout}"
                                   ToolTip="{StaticResource MaxFontTip}"/>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Grid.Column="1" TextWrapping="Wrap" Opacity="0.6" FontSize="11"
                                   Text="Every widget keeps its text within these sizes, whatever size the widget itself is."/>
                    </Grid>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Drives">
                <DockPanel Margin="10">
                    <TextBlock DockPanel.Dock="Bottom" Text="At least one drive must be shown."
                               Opacity="0.6" FontSize="11" Margin="0,8,0,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DriveList"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>

        <!-- Buttons, always below the tabs. -->
        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Button Content="Exit Application" HorizontalAlignment="Left"
                    Padding="12,5" Click="OnExitApplication"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" MinWidth="72" Padding="12,5" Margin="0,0,8,0"
                        IsCancel="True" Click="OnCancel"/>
                <Button x:Name="OkButton" Content="OK" MinWidth="72" Padding="12,5"
                        IsDefault="True" Click="OnOk"/>
            </StackPanel>
        </Grid>
    </Grid>
</views:ThemedWindow>
