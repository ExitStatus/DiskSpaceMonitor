<UserControl x:Class="DiskSpaceMonitor.Widgets.VerticalBar.VerticalBarGauge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Root fills the window: the bars are laid out in proportional Grid cells so they stretch
         with it in both directions, and only the text is scaled (see the code-behind), so
         stretching one direction alone resizes the bars without resizing the labels. -->
    <Grid x:Name="Root"/>
</UserControl>
