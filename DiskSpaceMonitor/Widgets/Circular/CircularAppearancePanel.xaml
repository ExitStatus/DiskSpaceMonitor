<UserControl x:Class="DiskSpaceMonitor.Widgets.Circular.CircularAppearancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <UserControl.Resources>
        <!-- Each row's explanation, shared by its caption, its slider and its readout so hovering
             anywhere along the row explains the setting. -->
        <sys:String x:Key="BackgroundTip">How solid the dark disc behind the gauge is. 0% leaves the ring floating on the wallpaper.</sys:String>
        <sys:String x:Key="ThicknessTip">How wide the ring band is drawn, in pixels at the gauge's design size. It scales with the widget.</sys:String>
        <sys:String x:Key="LowTip">A drive with less free space than this turns the ring the 'low' colour.</sys:String>
        <sys:String x:Key="CriticalTip">A drive with less free space than this turns the ring the 'critical' colour. It wins over the low threshold.</sys:String>

        <!-- Caption and readout match Views/SettingRow: the caption column sizes to this tab's
             longest caption and every slider starts where it ends. -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
        <Style x:Key="SettingReadout" TargetType="TextBlock">
            <Setter Property="Width" Value="44"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="6,16,6,6" Grid.IsSharedSizeScope="True">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Background" Style="{StaticResource SettingLabel}"
                       ToolTip="{StaticResource BackgroundTip}"/>
            <Slider x:Name="BackgroundSlider" Grid.Column="1"
                    Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                    VerticalAlignment="Center" ValueChanged="OnBackgroundChanged"
                    ToolTip="{StaticResource BackgroundTip}"/>
            <TextBlock x:Name="BackgroundValue" Grid.Column="2" Style="{StaticResource SettingReadout}"
                       ToolTip="{StaticResource BackgroundTip}"/>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Ring thickness" Style="{StaticResource SettingLabel}"
                       ToolTip="{StaticResource ThicknessTip}"/>
            <Slider x:Name="ThicknessSlider" Grid.Column="1"
                    Minimum="4" Maximum="40" SmallChange="1" LargeChange="4"
                    VerticalAlignment="Center" ValueChanged="OnThicknessChanged"
                    ToolTip="{StaticResource ThicknessTip}"/>
            <TextBlock x:Name="ThicknessValue" Grid.Column="2" Style="{StaticResource SettingReadout}"
                       ToolTip="{StaticResource ThicknessTip}"/>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Low threshold" Style="{StaticResource SettingLabel}"
                       ToolTip="{StaticResource LowTip}"/>
            <Slider x:Name="LowThresholdSlider" Grid.Column="1"
                    Minimum="1" Maximum="90" SmallChange="1" LargeChange="5"
                    VerticalAlignment="Center" ValueChanged="OnLowThresholdChanged"
                    ToolTip="{StaticResource LowTip}"/>
            <TextBlock x:Name="LowThresholdValue" Grid.Column="2" Style="{StaticResource SettingReadout}"
                       ToolTip="{StaticResource LowTip}"/>
        </Grid>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="SettingLabel"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Critical threshold" Style="{StaticResource SettingLabel}"
                       ToolTip="{StaticResource CriticalTip}"/>
            <Slider x:Name="CriticalThresholdSlider" Grid.Column="1"
                    Minimum="1" Maximum="90" SmallChange="1" LargeChange="5"
                    VerticalAlignment="Center" ValueChanged="OnCriticalThresholdChanged"
                    ToolTip="{StaticResource CriticalTip}"/>
            <TextBlock x:Name="CriticalThresholdValue" Grid.Column="2" Style="{StaticResource SettingReadout}"
                       ToolTip="{StaticResource CriticalTip}"/>
        </Grid>
    </StackPanel>
</UserControl>
